# Server environment variables (copy to server/.env)
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-random-secret-in-production"
PORT=3001

# Email — lascia vuoto per modalità dev (stampa in console invece di inviare)
# Funziona con Gmail, Outlook, Resend (host: smtp.resend.com), SendGrid, ecc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM="KPI Formazione ERP <noreply@yourcompany.it>"
APP_URL=http://localhost:5173

# Client environment variables (copy to client/.env)
VITE_API_URL=http://localhost:3001
