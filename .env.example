# ─── server/.env ────────────────────────────────────────────────────────────
# Copia questo file in server/.env e compila i valori

# Database SQLite (non modificare in sviluppo)
DATABASE_URL="file:./dev.db"

# Chiave segreta JWT — CAMBIALA con una stringa casuale lunga almeno 32 caratteri
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia-questo-valore-con-una-stringa-casuale-lunga"

# Porta del server (default 3001)
PORT=3001

# Modalità: development | production
# NODE_ENV=production

# In produzione: indirizzi autorizzati per CORS (separati da virgola)
# ALLOWED_ORIGINS=http://192.168.1.100:3001,http://miopc.local:3001

# ─── Email (opzionale) ───────────────────────────────────────────────────────
# Se non compilato, le email vengono stampate in console (modalità sviluppo)
# Funziona con Gmail, Outlook, Resend (smtp.resend.com), SendGrid, ecc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KPI Formazione ERP <noreply@tuaazienda.it>"
APP_URL=http://localhost:3001
